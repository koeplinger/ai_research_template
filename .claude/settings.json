{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "p=\"${CLAUDE_PROJECT_DIR:-.}/tools/session_brief.py\"; [ -f \"$p\" ] || exit 0; python3 \"$p\"",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "p=\"${CLAUDE_PROJECT_DIR:-.}/governance/harness/claude_code/stop_hook.py\"; [ -f \"$p\" ] || exit 0; python3 \"$p\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
