# Local-only privacy enforcement: the stop-word list tools/privacy_scan.py
# reads, and anything kept beside it. Never tracked.
.privacy/

# The per-user settings file of the harness the template was built with
# (governance/harness/claude_code/README.md); the shared file beside it is
# tracked. A project on another harness replaces this line with its own.
.claude/settings.local.json

# The run ledger, a local cache of check runs (tools/run_ledger.py), and the
# copy it keeps of a corrupt one. Never tracked.
.run_ledger.json*

# Python
*.py[cod]
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
.coverage
htmlcov/

# Editors and operating systems
.idea/
.DS_Store
Thumbs.db

# LaTeX build scratch (a compiled PDF is committed once it exists; scratch is not)
# A log released with a version, such as the log of a final run, is not
# scratch: a line of its own at the end of this file re-includes its path
# (paper/README.md, Releasing a version, step 7).
*.aux
*.log
*.out
*.toc
*.lof
*.lot
*.fls
*.fdb_latexmk
*.synctex.gz
*.bbl
*.blg
*.nav
*.snm
*.vrb

# Everything in the attachments folder stays visible to git whatever its
# extension, so that a file kept as received is committed and one named
# out of form is reported (prompt_logs/attachments/README.md); only the
# files an operating system writes there by itself stay ignored.
!prompt_logs/attachments/*
prompt_logs/attachments/.DS_Store
prompt_logs/attachments/Thumbs.db
